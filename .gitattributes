# Abugida SIS repository attributes
# Keep repository text files consistently normalized to LF.

* text=auto

# Source and configuration files
*.php text eol=lf
*.inc text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.po text eol=lf
*.pot text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows command files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.mo binary

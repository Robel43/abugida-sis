# Copy to .env.smtp (ignored by Git), or use AbugidaMail* in untracked config.inc.php.
# Use smtp.gmail.com, port 587, tls, and a Google App Password for Gmail.
ABUGIDA_SMTP_HOST=smtp.gmail.com
ABUGIDA_SMTP_PORT=587
ABUGIDA_SMTP_ENCRYPTION=tls
ABUGIDA_SMTP_AUTH=true
ABUGIDA_SMTP_USERNAME=
ABUGIDA_SMTP_PASSWORD=
ABUGIDA_SMTP_FROM=
ABUGIDA_SMTP_FROM_NAME=Abugida SIS
ABUGIDA_BASE_URL=http://localhost:8090
ABUGIDA_PAYMENT_INSTRUCTIONS="Contact the school for bank/account details, pay the registration fee, and upload the receipt."
